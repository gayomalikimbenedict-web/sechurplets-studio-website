# Copy these into Vercel: Project -> Settings -> Environment Variables. NEVER commit real values.

# PayPal (https://developer.paypal.com/dashboard/applications). Start with sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Postgres connection string (e.g. Neon via Vercel Storage). Required on Vercel.
DATABASE_URL=

# Your public site address (used for PayPal return links). Optional; auto-detected if empty.
SITE_URL=https://sechurplets-studio-website.vercel.app

# The "Make a copy" link of each Google Sheet: take the sheet's share link and change the end
# from  /edit?usp=sharing  to  /copy . These are the paid files, so keep them out of git.
DELIVERY_ORDER_CLEANER=
DELIVERY_SHOPIFY_RECONCILER=
DELIVERY_MERGE_DEDUPE=
DELIVERY_AUTO_REPORT_BUILDER=
DELIVERY_SUPPORT_SCORECARDS=
# Not set yet (no Google Sheet link provided): leave empty and this product cannot be bought online.
DELIVERY_TIME_ZONE_SYNC=
